<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	

    <Style Selector="Button.AddItemCommandButtonStyle">
		<Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
				<Border x:Name="border"
                        Height="28"
                        Width="28"
                        CornerRadius="1"
                        Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}">

                    <Viewbox Width="20"
                             Height="20"
                             Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{TemplateBinding Foreground}"
                                  Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
                        </Canvas>
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.AddItemCommandButtonStyle:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AddItemCommandButtonForegroundPointerOverBrush}" />
        <Setter Property="Background" Value="{DynamicResource AddItemCommandButtonBackgroundPointerOverBrush}" />
    </Style>

    <Style Selector="Window[IsActive=false] Button.AddItemCommandButtonStyle">
        <Setter Property="Foreground" Value="{DynamicResource InactiveWindowAddCommandButtonForegroundBrush}" />
    </Style>

    <Style
        Selector="Window[IsActive=false] Button.AddItemCommandButtonStyle:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource InactiveWindowAddCommandButtonPointerOverForegroundBrush}" />
    </Style>

    <Style Selector="Button.AddItemCommandButtonStyle.AddItemCommandButtonStyle:pressed">
        <Setter Property="Background" Value="{DynamicResource AddItemCommandButtonBackgroundPressedBrush}" />
    </Style>

    <Style Selector="Button.AddItemCommandButtonStyle">
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Button.TabScrollLeft, Button.TabScrollRight">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TabScrollNavigationButtonForegroundBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.TabScrollLeft">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Height="28"
                        Width="22"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}">
                    <Viewbox Width="16" Height="16" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{TemplateBinding Foreground}"
                                  Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
                        </Canvas>
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.TabScrollRight">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Height="28"
                        Width="22"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}">
                    <Viewbox Width="16" Height="16" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{TemplateBinding Foreground}"
                                  Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
                        </Canvas>
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.TabScrollLeft:pointerover, Button.TabScrollRight:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TabScrollNavigationButtonForegroundPointerOverBrush}" />
        <Setter Property="Background" Value="{DynamicResource TabScrollNavigationButtonBackgroundPointerOverBrush}" />
    </Style>

    <Style Selector="Button.TabScrollLeft:pressed, Button.TabScrollRight:pressed">
        <Setter Property="Background" Value="{DynamicResource TabScrollNavigationButtonBackgroundPressedBrush}" />
    </Style>

    <Style Selector="Button.TabScrollLeft:disabled, Button.TabScrollRight:disabled">
        <Setter Property="Foreground" Value="{DynamicResource TabScrollNavigationButtonForegroundDisabledBrush}" />
    </Style>

    <Style Selector="Window[IsActive=false] Button.TabScrollLeft, Window[IsActive=false] Button.TabScrollRight">
        <Setter Property="Foreground" Value="{DynamicResource TabScrollNavigationButtonForegroundInactiveBrush}" />
    </Style>

</Styles>